{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(gdb) SoC",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/x86_64/${input:buildType}/xr_3da",
      "args": [
        "-soc",
        "-nointro",
        "-fsltx",
        "${SOC_LTX_FILE_PATH}",
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/bin",
      "environment": [
        {
          "name": "LD_LIBRARY_PATH",
          "value": "${workspaceFolder}/bin/x86_64/${input:buildType}"
        }
      ],
      "preLaunchTask": "Compile",
      "externalConsole": false,
      "MIMode": "gdb"
    },
    {
      "name": "(gdb) CS",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/x86_64/${input:buildType}/xr_3da",
      "args": [
        "-cs",
        "-nointro",
        "-fsltx",
        "${CS_LTX_FILE_PATH}",
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/bin",
      "environment": [
        {
          "name": "LD_LIBRARY_PATH",
          "value": "${workspaceFolder}/bin/x86_64/${input:buildType}"
        }
      ],
      "preLaunchTask": "Compile",
      "externalConsole": false,
      "MIMode": "gdb"
    },
    {
      "name": "(gdb) CoP",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/x86_64/${input:buildType}/xr_3da",
      "args": [
        "-nointro",
        "-fsltx",
        "${COP_LTX_FILE_PATH}",
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/bin",
      "environment": [
        {
          "name": "LD_LIBRARY_PATH",
          "value": "${workspaceFolder}/bin/x86_64/${input:buildType}"
        }
      ],
      "preLaunchTask": "Compile",
      "externalConsole": false,
      "MIMode": "gdb"
    },
    {
      "name": "(gdb) CoC",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/x86_64/${input:buildType}/xr_3da",
      "args": [
        "-nointro",
        "-fsltx",
        "${COC_LTX_FILE_PATH}",
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/bin",
      "environment": [
        {
          "name": "LD_LIBRARY_PATH",
          "value": "${workspaceFolder}/bin/x86_64/${input:buildType}"
        }
      ],
      "preLaunchTask": "Compile",
      "externalConsole": false,
      "MIMode": "gdb"
    },
    {
      "name": "Debug (SoC)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/bin/arm64/${input:buildType}/xr_3da",
      "args": [
        "-soc",
        "-nointro"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "CMake: Build",
      "internalConsoleOptions": "openOnSessionStart"
    },
    {
      "name": "Debug (CS)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/bin/arm64/${input:buildType}/xr_3da",
      "args": [
        "-cs",
        "-nointro"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "CMake: Build",
      "internalConsoleOptions": "openOnSessionStart"
    },
    {
      "name": "Debug (CoP)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/bin/arm64/${input:buildType}/xr_3da",
      "args": [
        "-nointro"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "CMake: Build",
      "internalConsoleOptions": "openOnSessionStart"
    },
    {
      "name": "Debug (CoC)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/bin/arm64/${input:buildType}/xr_3da",
      "args": [
        "-nointro"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "CMake: Build",
      "internalConsoleOptions": "openOnSessionStart"
    },
    {
      "name": "Attach to xr_3da",
      "type": "lldb",
      "request": "attach",
      "program": "${workspaceFolder}/bin/arm64/${input:buildType}/xr_3da",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug (Metal / CoP)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/bin/arm64/${input:buildType}/xr_3da",
      "args": [
        "-metal",
        "-nointro",
        "-fsltx",
        "${input:fsltxPath}"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Metal: Build All",
      "internalConsoleOptions": "openOnSessionStart"
    }
  ],
  "inputs": [
    {
      "id": "buildType",
      "type": "pickString",
      "description": "choose build type:",
      "options": [
        "Debug",
        "Release",
        "Mixed",
        "ReleaseMasterGold"
      ],
      "default": "ReleaseMasterGold"
    },
    {
      "id": "fsltxPath",
      "type": "promptString",
      "description": "Path to .ltx file for Metal"
    }
  ]
}
